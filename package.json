{
  "name": "dameosai-tailwind-cdn",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Tailwind CSS v4 utility CDN for DameosAI",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}